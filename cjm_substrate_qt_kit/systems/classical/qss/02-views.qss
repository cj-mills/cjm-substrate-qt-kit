/* tabs: underline in accent, heading face */
QTabWidget::pane { border: none; border-top: 1px solid $divider; top: -1px; background: transparent; }
QTabWidget::tab-bar { left: 0; }
QTabBar { background: transparent; qproperty-drawBase: 0; }
QTabBar::tab {
  font-family: "$font_heading"; font-weight: $heading_weight; font-size: 15px;
  color: $muted; background: transparent; border: none; border-bottom: 2px solid transparent;
  padding: 8px 14px; margin-right: 2px;
}
QTabBar::tab:hover { color: $text; }
QTabBar::tab:selected { color: $accent; border-bottom-color: $accent; }
QTabBar::tab:disabled { color: $disabled_text; }
QTabBar::close-button { image: url($icon_x); subcontrol-position: right; }
QTabBar::close-button:hover { background: $text_hover; border-radius: ${radius_sm}px; }

/* tables, trees, lists: hairline rows, themed header */
QAbstractItemView {
  background: transparent; alternate-background-color: $row_alt; color: $text;
  border: 1px solid $divider; border-radius: ${radius_md}px; outline: 0;
  selection-background-color: $accent_hover; selection-color: $text; gridline-color: $divider;
  font-size: 14px;
}
QTableView::item, QTreeView::item, QListView::item { padding: 6px ${space_2}px; border: none; border-bottom: 1px solid $divider; }
QListView::item { border-bottom: none; border-radius: ${radius_sm}px; }
QTableView::item:hover, QTreeView::item:hover, QListView::item:hover { background: $row_hover; }
QTableView::item:selected, QTreeView::item:selected, QListView::item:selected { background: $accent_hover; color: $accent_text; }
QTableView QTableCornerButton::section { background: transparent; border: none; border-bottom: 1px solid $divider; }
QHeaderView { background: transparent; border: none; }
QHeaderView::section {
  background: transparent; color: $header_text; font-size: 11px;
  padding: ${space_2}px; border: none; border-bottom: 1px solid $divider;
}
QHeaderView::section:hover { color: $text; }
QHeaderView::up-arrow { image: url($icon_chevron_up); width: 10px; height: 10px; subcontrol-position: center right; }
QHeaderView::down-arrow { image: url($icon_chevron_down); width: 10px; height: 10px; subcontrol-position: center right; }
QTreeView::branch { background: transparent; border-bottom: 1px solid $divider; }
QTreeView::branch:has-children:closed { image: url($icon_chevron_right); }
QTreeView::branch:has-children:open { image: url($icon_chevron_down); }

/* menus & toolbars */
QMenuBar { background: $bg; border-bottom: 1px solid $divider; padding: 2px 6px; }
QMenuBar::item { background: transparent; padding: 6px 10px; border-radius: ${radius_sm}px; }
QMenuBar::item:selected { color: $accent; background: transparent; }
QMenuBar::item:pressed { color: $accent; background: $ghost_hover; }
QMenu { background: $surface; color: $text; border: 1px solid $divider; border-radius: ${radius_md}px; padding: 4px; }
QMenu::item { padding: 6px 28px 6px 12px; border-radius: ${radius_sm}px; background: transparent; }
QMenu::item:selected { background: $accent_hover; color: $accent_text; }
QMenu::item:disabled { color: $disabled_text; }
QMenu::icon { padding-left: 8px; }
QMenu::separator { height: 1px; background: $divider; margin: 4px 8px; }
QMenu::indicator { width: 14px; height: 14px; left: 6px; }
QMenu::indicator:checked { image: url($icon_check); }
QMenu::right-arrow { image: url($icon_chevron_right); width: 12px; height: 12px; }
QToolBar { background: $bg; border: none; border-bottom: 1px solid $divider; spacing: 4px; padding: 4px 8px; }
QToolBar::separator { background: $divider; width: 1px; margin: 6px 6px; }
QToolBar::handle { width: 0; }
QStatusBar { background: $bg; color: $muted; border-top: 1px solid $divider; font-size: 12px; }
QStatusBar::item { border: none; }
QToolTip { background: $surface; color: $text; border: 1px solid $divider; padding: 4px 8px; font-size: 12px; }

/* scrollbars: thin, quiet, no arrows */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: $scroll_handle; border-radius: 3px; min-height: 28px; margin: 0 1px; }
QScrollBar::handle:horizontal { background: $scroll_handle; border-radius: 3px; min-width: 28px; margin: 1px 0; }
QScrollBar::handle:hover, QScrollBar::handle:pressed { background: $scroll_handle_hover; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background: transparent; }

/* sliders & progress: hairline track, accent as a mark */
QSlider { min-height: 20px; }
QSlider::groove:horizontal { height: 2px; background: $divider_strong; border-radius: 1px; }
QSlider::sub-page:horizontal { height: 2px; background: $accent; border-radius: 1px; }
QSlider::handle:horizontal { width: 12px; height: 12px; margin: -6px 0; border-radius: 7px; border: 1px solid $accent; background: $bg; }
QSlider::groove:vertical { width: 2px; background: $divider_strong; border-radius: 1px; }
QSlider::add-page:vertical { width: 2px; background: $accent; border-radius: 1px; }
QSlider::handle:vertical { width: 12px; height: 12px; margin: 0 -6px; border-radius: 7px; border: 1px solid $accent; background: $bg; }
QSlider::handle:hover { background: $accent_hover; }
QSlider::handle:pressed { border-color: $accent_pressed; background: $accent_press_tint; }
QSlider::handle:disabled { border-color: $disabled_border; }
QSlider::sub-page:disabled, QSlider::add-page:vertical:disabled { background: $disabled_border; }
QProgressBar { border: 1px solid $divider; border-radius: ${radius_sm}px; background: transparent; max-height: 6px; min-height: 6px; color: transparent; text-align: center; }
QProgressBar::chunk { background: $accent; border-radius: 1px; margin: 1px; }

/* cards & group boxes */
QFrame[card="true"] { background: transparent; border: 1px solid $divider; border-radius: ${radius_md}px; }
QFrame[card="true"][elevated="true"] { background: $bg; }
QDialog QFrame[card="true"][elevated="true"] { background: $surface; }
QFrame[card="true"] QLabel { border: none; }
QGroupBox { border: 1px solid $divider; border-radius: ${radius_md}px; margin-top: 14px; padding: ${space_3}px; padding-top: ${space_4}px; font-family: "$font_heading"; font-weight: $heading_weight; font-size: 15px; }
QGroupBox::title { subcontrol-origin: margin; left: ${space_3}px; padding: 0 4px; color: $text; }

/* dialogs */
QDialog QLabel[role="dialog-body"] { font-size: 14px; color: $label; }
QDialogButtonBox { dialogbuttonbox-buttons-have-icons: 0; }
QMessageBox { background: $surface; }
QMessageBox QLabel { font-size: 14px; }
